# Frontend Environment Configuration
NODE_ENV=development
NEXT_PUBLIC_BYPASS_AUTH=false

# Base URL for the MindSchool API
NEXT_PUBLIC_API_URL=http://localhost:3011/api/v1

# Frontend Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3001


# Session Secret for cookie encryption
SESSION_SECRET=mindschool-frontend-session-secret-key-super-secure-32chars

# Chatbot API
NEXT_PUBLIC_CHATBOT_API_URL=https://chatbot.mindware-vps.cloud/chat
