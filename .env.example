# ==============================================================================
# MINDSCHOOL FRONTEND - variaveis de ambiente
# Copiar para `.env.local` (desenvolvimento) ou configurar no servidor/Dokploy (producao).
# Todas as `NEXT_PUBLIC_*` sao embutidas no JavaScript NO BUILD: mudar uma exige novo build.
# ==============================================================================

# ---- OBRIGATORIAS ------------------------------------------------------------

# URL base da API, JA COM o prefixo /api/v1 (sem barra final).
#   desenvolvimento: http://localhost:3011/api/v1      producao: https://api.mindschool.ao/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3011/api/v1

# URL publica deste frontend (links, metadados e cookies de sessao).
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Segredo que assina o cookie de papel do utilizador (>= 32 caracteres; gerar com `openssl rand -base64 48`).
# Obrigatorio em producao (so e lido quando o servidor arranca; o build nao precisa dele). So no servidor: nunca NEXT_PUBLIC_.
SESSION_SECRET=troque-isto-por-um-segredo-de-pelo-menos-32-caracteres

# ---- OPCIONAIS ---------------------------------------------------------------

# Assistente de chat (se omitido usa o servico por omissao).
# NEXT_PUBLIC_CHATBOT_API_URL=https://chatbot.mindware-vps.cloud/chat

# Mostra no menu modulos ainda sem pagina ligada (so para desenvolvimento).
# NEXT_PUBLIC_SHOW_UNLINKED_MODULES=false

# Onboarding/tutoriais vindos da API em vez dos locais.
# NEXT_PUBLIC_ONBOARDING_REMOTE=false

# NUNCA activar em producao: desliga a verificacao de sessao no frontend (so para demos locais sem API).
# NEXT_PUBLIC_BYPASS_AUTH=false
